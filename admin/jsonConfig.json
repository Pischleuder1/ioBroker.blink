{
  "i18n": true,
  "type": "tabs",
  "tabsStyle": {
    "width": "calc(100% - 100px)"
  },
  "items": {
    "tab_connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "email": {
          "type": "text",
          "label": "Blink username / email",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "password": {
          "type": "password",
          "label": "Password",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "pin": {
          "type": "password",
          "label": "PIN / 2FA code (optional)",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "settings_header": {
          "type": "header",
          "text": "Settings",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "pollIntervalSec": {
          "type": "number",
          "label": "Status polling interval (sec.)",
          "min": 15,
          "max": 3600,
          "default": 60,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "snapshotDir": {
          "type": "text",
          "label": "Snapshot directory",
          "default": "/opt/iobroker/iobroker-data/blinkpy",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "debugLogEnabled": {
          "type": "checkbox",
          "label": "Enable Blink debug log",
          "help": "Writes /tmp/blink_debug.log",
          "default": false,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "liveSnapshotEnabled": {
          "type": "checkbox",
          "label": "Enable live image via snapshots",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "liveSnapshotIntervalSec": {
          "type": "number",
          "label": "Live image interval (sec.)",
          "min": 5,
          "max": 3600,
          "default": 30,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "storeBase64": {
          "type": "checkbox",
          "label": "Also store image as Base64 data URL in state",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "cleanupOldSnapshots": {
          "type": "checkbox",
          "label": "Automatically delete old snapshot files",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "maxSnapshotAgeHours": {
          "type": "number",
          "label": "Maximum snapshot file age (hours)",
          "min": 1,
          "max": 168,
          "default": 24,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        }
      }
    },
    "tab_notifications": {
      "type": "panel",
      "label": "Notifications",
      "items": {
        "battery_header": {
          "type": "header",
          "text": "Battery warning",
          "size": 4,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "batteryWarningEnabled": {
          "type": "checkbox",
          "label": "Enable battery warning",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "batteryVoltThreshold": {
          "type": "number",
          "label": "Battery voltage threshold (V)",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 2.5,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "batteryWarnCooldownHours": {
          "type": "number",
          "label": "Battery warning cooldown per camera (hours)",
          "min": 1,
          "max": 720,
          "default": 24,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_channels_header": {
          "type": "staticText",
          "text": "Battery warning channels",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "battery_telegram_enabled": {
          "type": "checkbox",
          "label": "Enable Telegram for battery warnings",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_telegram_instance": {
          "type": "text",
          "label": "Telegram instance",
          "default": "telegram.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_telegram_users": {
          "type": "text",
          "label": "Telegram recipients",
          "help": "Comma-separated Telegram users. Leave empty to use all configured recipients.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 4,
          "xl": 4
        },
        "battery_pushover_enabled": {
          "type": "checkbox",
          "label": "Enable Pushover for battery warnings",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_pushover_instance": {
          "type": "text",
          "label": "Pushover instance",
          "default": "pushover.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_email_enabled": {
          "type": "checkbox",
          "label": "Enable email for battery warnings",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_email_instance": {
          "type": "text",
          "label": "Email instance",
          "default": "email.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "battery_email_to": {
          "type": "text",
          "label": "Email recipient for battery warnings",
          "help": "Leave empty to use the default recipient configured in the email adapter.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 4,
          "xl": 4
        },
        "motion_header": {
          "type": "header",
          "text": "Motion notification",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "motionNotifyEnabled": {
          "type": "checkbox",
          "label": "Enable motion notification",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motionNotifyCooldownMinutes": {
          "type": "number",
          "label": "Motion notification cooldown per camera (minutes)",
          "min": 1,
          "max": 1440,
          "default": 15,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_channels_header": {
          "type": "staticText",
          "text": "Motion notification channels",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "motion_telegram_enabled": {
          "type": "checkbox",
          "label": "Enable Telegram for motion notifications",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_telegram_instance": {
          "type": "text",
          "label": "Telegram instance",
          "default": "telegram.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_telegram_users": {
          "type": "text",
          "label": "Telegram recipients",
          "help": "Comma-separated Telegram users. Leave empty to use all configured recipients.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 4,
          "xl": 4
        },
        "motion_pushover_enabled": {
          "type": "checkbox",
          "label": "Enable Pushover for motion notifications",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_pushover_instance": {
          "type": "text",
          "label": "Pushover instance",
          "default": "pushover.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_email_enabled": {
          "type": "checkbox",
          "label": "Enable email for motion notifications",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_email_instance": {
          "type": "text",
          "label": "Email instance",
          "default": "email.0",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "motion_email_to": {
          "type": "text",
          "label": "Email recipient for motion notifications",
          "help": "Leave empty to use the default recipient configured in the email adapter.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 4,
          "xl": 4
        }
      }
    },
    "tab_streaming": {
      "type": "panel",
      "label": "Streaming",
      "items": {
        "stream_intro_header": {
          "type": "header",
          "text": "MJPEG live stream",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "stream_intro": {
          "type": "staticText",
          "text": "The adapter provides a local HTTP server that exposes live images as an MJPEG stream per camera. Wired cameras such as Mini, Floodlight and Doorbell are polled continuously. Battery-powered cameras are only polled while a stream client is connected or when live_request was triggered.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "streamEnabled": {
          "type": "checkbox",
          "label": "MJPEG-Streaming aktivieren",
          "default": false,
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamPort": {
          "type": "number",
          "label": "HTTP-Port",
          "min": 1024,
          "max": 65535,
          "default": 8089,
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamToken": {
          "type": "text",
          "label": "Stream-Token",
          "help": "Protects the stream URLs. If this field is empty, a token is generated automatically when the adapter starts and is stored here.",
          "default": "",
          "copyToClipboard": true,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 8,
          "xl": 8,
          "md": 12
        },
        "streamPublicHost": {
          "type": "text",
          "label": "Public host (optional)",
          "help": "IP address or hostname for the stream URL, for example iobroker.local or 192.168.1.50. Leave empty for automatic detection.",
          "default": "",
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "stream_perf_header": {
          "type": "header",
          "text": "Polling-Verhalten",
          "size": 4,
          "newLine": true,
          "hidden": "!data.streamEnabled",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "streamWiredIntervalSec": {
          "type": "number",
          "label": "Wired camera minimum interval (sec.)",
          "help": "Minimum pause between two snapshots of the same wired camera. In practice, cloud latency can make the interval longer.",
          "min": 5,
          "max": 600,
          "default": 8,
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryIntervalSec": {
          "type": "number",
          "label": "Battery camera minimum interval (sec.)",
          "min": 8,
          "max": 600,
          "default": 10,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryIdleTimeoutSec": {
          "type": "number",
          "label": "Battery camera run-on after disconnect (sec.)",
          "help": "Polling continues for this duration after the last stream disconnect or live_request before it is stopped.",
          "min": 15,
          "max": 600,
          "default": 60,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryMinLevel": {
          "type": "select",
          "label": "Minimum battery level for battery polling",
          "help": "Battery-powered cameras below this level are not polled to protect the battery.",
          "default": 2,
          "options": [
            {
              "value": 0,
              "label": "0 - always poll (no protection)"
            },
            {
              "value": 1,
              "label": "1 - also poll with low battery"
            },
            {
              "value": 2,
              "label": "2 - only poll when battery level is OK (recommended)"
            },
            {
              "value": 3,
              "label": "3 - only poll when battery is full"
            }
          ],
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "stream_hint_header": {
          "type": "header",
          "text": "Usage",
          "size": 4,
          "newLine": true,
          "hidden": "!data.streamEnabled",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "stream_hint_text": {
          "type": "staticText",
          "text": "After saving, the final URL is available for each camera under cameras.<id>.live.stream_url. You can use it in VIS in an HTML widget via <img src=\"...\">.",
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  }
}
