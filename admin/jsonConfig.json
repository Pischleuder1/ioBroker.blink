{
  "i18n": true,
  "type": "tabs",
  "tabsStyle": {
    "width": "calc(100% - 100px)"
  },
  "items": {
    "tab_connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "email": {
          "type": "text",
          "label": "Blink username / email",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "password": {
          "type": "password",
          "label": "Password",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "pin": {
          "type": "password",
          "label": "PIN / 2FA code (optional)",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "settings_header": {
          "type": "header",
          "text": "Settings",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "pollIntervalSec": {
          "type": "number",
          "label": "Status polling interval (sec.)",
          "min": 15,
          "max": 3600,
          "default": 60,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "snapshotDir": {
          "type": "text",
          "label": "Snapshot directory",
          "default": "/opt/iobroker/iobroker-data/blinkpy",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "debugLogEnabled": {
          "type": "checkbox",
          "label": "Enable Blink debug log",
          "help": "Writes /tmp/blink_debug.log",
          "default": false,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "liveSnapshotEnabled": {
          "type": "checkbox",
          "label": "Enable live image via snapshots",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "liveSnapshotIntervalSec": {
          "type": "number",
          "label": "Live image interval (sec.)",
          "min": 5,
          "max": 3600,
          "default": 10,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "storeBase64": {
          "type": "checkbox",
          "label": "Also store image as Base64 data URL in state",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "cleanupOldSnapshots": {
          "type": "checkbox",
          "label": "Automatically delete old snapshot files",
          "default": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "maxSnapshotAgeHours": {
          "type": "number",
          "label": "Maximum snapshot file age (hours)",
          "min": 1,
          "max": 168,
          "default": 24,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        }
      }
    },
    "tab_notifications": {
      "type": "panel",
      "label": "Notifications",
      "items": {
        "notify_batt_header": {
          "type": "header",
          "text": "Battery warning",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "batteryWarningEnabled": {
          "type": "checkbox",
          "label": "Enable battery warning",
          "default": false,
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "batteryWarningThresholdVolt": {
          "type": "number",
          "label": "Battery voltage threshold (V)",
          "default": 1.1,
          "newLine": true,
          "min": 0,
          "max": 5,
          "step": 0.01,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "batteryWarningCooldownHours": {
          "type": "number",
          "label": "Warning cooldown per camera (hours)",
          "default": 24,
          "newLine": true,
          "min": 1,
          "max": 720,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "notify_header": {
          "type": "header",
          "text": "If status.battery_volt is less than or equal to the threshold, at most one Pushover notification per camera is sent within the cooldown period.",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "notify_telegram_enabled": {
          "type": "checkbox",
          "label": "Enable Telegram notifications",
          "default": false,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "notify_telegram_instance": {
          "type": "instance",
          "adapter": "telegram",
          "label": "Telegram instance",
          "default": "telegram.0",
          "hidden": "!data.notify_telegram_enabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "notify_telegram_users": {
          "type": "text",
          "label": "Recipients (usernames, comma-separated – empty = all users)",
          "help": "Example: John,Jane   (leave empty to send to all users)",
          "default": "",
          "hidden": "!data.notify_telegram_enabled",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "notify_pushover_enabled": {
          "type": "checkbox",
          "label": "Enable pushover notifications",
          "default": false,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "notify_pushover_instance": {
          "type": "instance",
          "adapter": "pushover",
          "label": "pushover instance",
          "default": "pushover.0",
          "hidden": "!data.notify_pushover_enabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        }
      }
    },
    "tab_streaming": {
      "type": "panel",
      "label": "Streaming",
      "items": {
        "stream_intro_header": {
          "type": "header",
          "text": "MJPEG live stream",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "stream_intro": {
          "type": "staticText",
          "text": "The adapter provides a local HTTP server that exposes live images as an MJPEG stream per camera. Wired cameras such as Mini, Floodlight and Doorbell are polled continuously. Battery-powered cameras are only polled while a stream client is connected or when live_request was triggered.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "streamEnabled": {
          "type": "checkbox",
          "label": "MJPEG-Streaming aktivieren",
          "default": false,
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamPort": {
          "type": "number",
          "label": "HTTP-Port",
          "min": 1024,
          "max": 65535,
          "default": 8089,
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamToken": {
          "type": "text",
          "label": "Stream-Token",
          "help": "Protects the stream URLs. If this field is empty, a token is generated automatically when the adapter starts and is stored here.",
          "default": "",
          "copyToClipboard": true,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 8,
          "xl": 8,
          "md": 12
        },
        "streamPublicHost": {
          "type": "text",
          "label": "Public host (optional)",
          "help": "IP address or hostname for the stream URL, for example iobroker.local or 192.168.1.50. Leave empty for automatic detection.",
          "default": "",
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "stream_perf_header": {
          "type": "header",
          "text": "Polling-Verhalten",
          "size": 4,
          "newLine": true,
          "hidden": "!data.streamEnabled",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "streamWiredIntervalSec": {
          "type": "number",
          "label": "Wired camera minimum interval (sec.)",
          "help": "Minimum pause between two snapshots of the same wired camera. In practice, cloud latency can make the interval longer.",
          "min": 5,
          "max": 600,
          "default": 8,
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryIntervalSec": {
          "type": "number",
          "label": "Battery camera minimum interval (sec.)",
          "min": 8,
          "max": 600,
          "default": 10,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryIdleTimeoutSec": {
          "type": "number",
          "label": "Battery camera run-on after disconnect (sec.)",
          "help": "Polling continues for this duration after the last stream disconnect or live_request before it is stopped.",
          "min": 15,
          "max": 600,
          "default": 60,
          "hidden": "!data.streamEnabled",
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "streamBatteryMinLevel": {
          "type": "select",
          "label": "Minimum battery level for battery polling",
          "help": "Battery-powered cameras below this level are not polled to protect the battery.",
          "default": 2,
          "options": [
            {
              "value": 0,
              "label": "0 - immer pollen (kein Schutz)"
            },
            {
              "value": 1,
              "label": "1 - auch bei niedrigem Akku"
            },
            {
              "value": 2,
              "label": "2 - nur bei OK-Stand (empfohlen)"
            },
            {
              "value": 3,
              "label": "3 - nur bei vollem Akku"
            }
          ],
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "sm": 12,
          "xs": 12,
          "lg": 4,
          "xl": 4,
          "md": 6
        },
        "stream_hint_header": {
          "type": "header",
          "text": "Usage",
          "size": 4,
          "newLine": true,
          "hidden": "!data.streamEnabled",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "stream_hint_text": {
          "type": "staticText",
          "text": "Pro Kamera findest du nach dem Speichern unter cameras.<id>.live.stream_url die fertige URL. Diese kannst du in VIS in einem HTML-Widget per <img src=\"...\"> einbinden.",
          "hidden": "!data.streamEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  }
}
